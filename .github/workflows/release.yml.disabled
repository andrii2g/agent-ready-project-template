name: Release

on:
  workflow_dispatch:
    inputs:
      tag:
        description: Existing reviewed tag to publish
        required: true

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    environment: release
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7.0.0
        with:
          ref: ${{ inputs.tag }}
          persist-credentials: false
      - name: Require explicit human-reviewed release implementation
        run: |
          echo "This workflow is an example and must be adapted before enabling."
          exit 1
